@page "/admin/catalog"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject ClientState State

<PageTitle>Catalogo administrativo</PageTitle>

<section class="admin-imports-shell admin-catalog-shell">
    <div class="admin-imports-hero">
        <div>
            <span>Admin</span>
            <h1>Catalogo</h1>
            <p>Gerencie cada modulo separadamente: categorias, subcategorias e atributos.</p>
        </div>
    </div>

    @if (!State.IsAuthenticated || !State.IsAdmin)
    {
        <div class="admin-import-card">Faca login como admin para acessar esta area.</div>
    }
    else
    {
        <div class="admin-catalog-modules">
            <a class="admin-import-card admin-catalog-module" href="/admin/catalog/categories">
                <span class="admin-card-eyebrow">Modulo</span>
                <h2>Categorias</h2>
                <p>Cadastre categorias e acesse subcategorias filhas.</p>
            </a>

            <a class="admin-import-card admin-catalog-module" href="/admin/catalog/subcategories">
                <span class="admin-card-eyebrow">Modulo</span>
                <h2>Subcategorias</h2>
                <p>Visualize subcategorias por categoria pai e mantenha a arvore organizada.</p>
            </a>

            <a class="admin-import-card admin-catalog-module" href="/admin/catalog/attributes">
                <span class="admin-card-eyebrow">Modulo</span>
                <h2>Atributos</h2>
                <p>Mantenha os atributos tecnicos usados nos produtos administrativos.</p>
            </a>
        </div>
    }
</section>
