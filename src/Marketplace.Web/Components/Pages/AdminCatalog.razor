@page "/admin/catalog"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject MarketplaceApiClient Api
@inject ClientState State
@inject NavigationManager Navigation

<PageTitle>Catalogo administrativo</PageTitle>

<section class="admin-imports-shell admin-catalog-shell">
    <div class="admin-imports-hero">
        <div>
            <span>Admin</span>
            <h1>Catalogo</h1>
            <p>Categorias, subcategorias e atributos da ficha tecnica.</p>
        </div>
        <div class="segment-control">
            <button class="btn @(tab == AdminCatalogTab.Categories ? "btn-primary" : "btn-outline-secondary")" @onclick="() => tab = AdminCatalogTab.Categories">Categorias</button>
            <button class="btn @(tab == AdminCatalogTab.SubCategories ? "btn-primary" : "btn-outline-secondary")" @onclick="() => tab = AdminCatalogTab.SubCategories">Subcategorias</button>
            <button class="btn @(tab == AdminCatalogTab.Attributes ? "btn-primary" : "btn-outline-secondary")" @onclick="() => tab = AdminCatalogTab.Attributes">Atributos</button>
        </div>
    </div>

    @if (!State.IsAuthenticated)
    {
        <div class="admin-import-card">Faca login como admin para acessar esta area.</div>
    }
    else if (loading)
    {
        <div class="admin-import-card">Carregando dados do catalogo...</div>
    }
    else
    {
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="notice @(successMessage ? "notice-success" : null)">@message</p>
    }

    @switch (tab)
    {
        case AdminCatalogTab.Categories:
            <section class="admin-import-card admin-table-card">
                <div class="admin-table-header">
                    <div>
                        <span class="admin-card-eyebrow">Categorias</span>
                        <h2>Categorias cadastradas</h2>
                    </div>
                    <button class="btn btn-primary" type="button" @onclick="CreateCategory">Nova categoria</button>
                </div>

                <form class="admin-filter-bar admin-catalog-filter" @onsubmit="SearchCategoriesAsync" @onsubmit:preventDefault="true">
                    <input class="form-control" placeholder="Buscar categoria" @bind="categorySearch" @bind:event="oninput" />
                    <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                </form>

                <div class="admin-table-scroll">
                    <table class="table admin-data-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th><button class="table-sort" type="button" @onclick='() => SortCategories("title")'>Categoria</button></th>
                                <th>Imagem</th>
                                <th class="number-cell">Subcategorias</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in FilteredCategories)
                            {
                                <tr>
                                    <td class="actions-column">
                                        <div class="action-cell">
                                            <button class="btn btn-sm btn-outline-secondary icon-action" type="button" title="Editar" @onclick="() => EditCategory(category.Id)">
                                                <i class="fa fa-pen"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteCategoryAsync(category.Id)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>@category.Title</td>
                                    <td>@category.Image</td>
                                    <td>@category.SubCategories.Length</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
                break;
            case AdminCatalogTab.SubCategories:
                <section class="admin-import-card admin-table-card">
                    <div class="admin-table-header">
                        <div>
                            <span class="admin-card-eyebrow">Subcategorias</span>
                            <h2>Subcategorias cadastradas</h2>
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="CreateSubCategory">Nova subcategoria</button>
                    </div>

                    <form class="admin-filter-bar admin-catalog-filter" @onsubmit="SearchSubCategoriesAsync" @onsubmit:preventDefault="true">
                        <input class="form-control" placeholder="Buscar subcategoria" @bind="subCategorySearch" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                    </form>

                    <div class="admin-table-scroll">
                        <table class="table admin-data-table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th><button class="table-sort" type="button" @onclick='() => SortSubCategories("title")'>Subcategoria</button></th>
                                    <th><button class="table-sort" type="button" @onclick='() => SortSubCategories("category")'>Categoria</button></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var subCategory in FilteredSubCategories)
                                {
                                    <tr>
                                        <td class="actions-column">
                                            <div class="action-cell">
                                                <button class="btn btn-sm btn-outline-secondary icon-action" type="button" title="Editar" @onclick="() => EditSubCategory(subCategory.Id)">
                                                    <i class="fa fa-pen"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteSubCategoryAsync(subCategory.Id)">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>@subCategory.Title</td>
                                        <td>@subCategory.Category</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                break;
            case AdminCatalogTab.Attributes:
                <section class="admin-import-card admin-table-card">
                    <div class="admin-table-header">
                        <div>
                            <span class="admin-card-eyebrow">Atributos</span>
                            <h2>Atributos cadastrados</h2>
                        </div>
                        <button class="btn btn-primary" type="button" @onclick="CreateAttribute">Novo atributo</button>
                    </div>

                    <form class="admin-filter-bar admin-catalog-filter" @onsubmit="SearchAttributesAsync" @onsubmit:preventDefault="true">
                        <input class="form-control" placeholder="Buscar atributo" @bind="attributeSearch" @bind:event="oninput" />
                        <button class="btn btn-outline-secondary" type="submit">Buscar</button>
                    </form>

                    <div class="admin-table-scroll">
                        <table class="table admin-data-table">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th><button class="table-sort" type="button" @onclick='() => SortAttributes("name")'>Atributo</button></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var catalogAttribute in FilteredAttributes)
                                {
                                    <tr>
                                        <td class="actions-column">
                                            <div class="action-cell">
                                                <button class="btn btn-sm btn-outline-secondary icon-action" type="button" title="Editar" @onclick="() => EditAttribute(catalogAttribute.Id)">
                                                    <i class="fa fa-pen"></i>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteAttributeAsync(catalogAttribute.Id)">
                                                    <i class="fa fa-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                        <td>@catalogAttribute.Name</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
                break;
        }
    }
</section>

@code {
    private AdminCatalogTab tab = AdminCatalogTab.Categories;
    private bool loading;
    private string? message;
    private bool successMessage;
    private AdminCategory[] categories = [];
    private AdminSubCategory[] subCategories = [];
    private AdminAttribute[] attributes = [];
    private string categorySearch = string.Empty;
    private string subCategorySearch = string.Empty;
    private string attributeSearch = string.Empty;
    private string categorySort = "title";
    private string categoryDirection = "asc";
    private string subCategorySort = "title";
    private string subCategoryDirection = "asc";
    private string attributeSort = "name";
    private string attributeDirection = "asc";
    private IEnumerable<AdminCategory> FilteredCategories =>
        ApplyCategorySort(categories.Where(category =>
            string.IsNullOrWhiteSpace(categorySearch) ||
            category.Title.Contains(categorySearch, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<AdminSubCategory> FilteredSubCategories =>
        ApplySubCategorySort(subCategories.Where(subCategory =>
            string.IsNullOrWhiteSpace(subCategorySearch) ||
            subCategory.Title.Contains(subCategorySearch, StringComparison.OrdinalIgnoreCase) ||
            subCategory.Category.Contains(subCategorySearch, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<AdminAttribute> FilteredAttributes =>
        ApplyAttributeSort(attributes.Where(catalogAttribute =>
            string.IsNullOrWhiteSpace(attributeSearch) ||
            catalogAttribute.Name.Contains(attributeSearch, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.Uri.Contains("saved=category", StringComparison.OrdinalIgnoreCase))
        {
            message = "Categoria salva com sucesso.";
            successMessage = true;
        }
        else if (Navigation.Uri.Contains("saved=subcategory", StringComparison.OrdinalIgnoreCase))
        {
            message = "Subcategoria salva com sucesso.";
            successMessage = true;
        }
        else if (Navigation.Uri.Contains("saved=attribute", StringComparison.OrdinalIgnoreCase))
        {
            message = "Atributo salvo com sucesso.";
            successMessage = true;
        }

        if (State.IsAuthenticated)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        categories = await Api.GetAdminCategoriesAsync();
        subCategories = await Api.GetAdminSubCategoriesAsync();
        attributes = await Api.GetAdminAttributesAsync();
        loading = false;
    }

    private void CreateCategory() => Navigation.NavigateTo("/admin/catalog/categories/create");
    private void EditCategory(int id) => Navigation.NavigateTo($"/admin/catalog/categories/{id}/edit");

    private Task SearchCategoriesAsync() => Task.CompletedTask;

    private void SortCategories(string column)
    {
        if (categorySort == column)
        {
            categoryDirection = categoryDirection == "asc" ? "desc" : "asc";
            return;
        }

        categorySort = column;
        categoryDirection = "asc";
    }

    private async Task DeleteCategoryAsync(int id)
    {
        await Api.DeleteCategoryAsync(id);
        message = "Categoria excluida.";
        successMessage = true;
        await LoadAsync();
    }

    private void CreateSubCategory() => Navigation.NavigateTo("/admin/catalog/subcategories/create");
    private void EditSubCategory(int id) => Navigation.NavigateTo($"/admin/catalog/subcategories/{id}/edit");

    private async Task DeleteSubCategoryAsync(int id)
    {
        await Api.DeleteSubCategoryAsync(id);
        message = "Subcategoria excluida.";
        await LoadAsync();
    }

    private Task SearchSubCategoriesAsync() => Task.CompletedTask;

    private void SortSubCategories(string column)
    {
        if (subCategorySort == column)
        {
            subCategoryDirection = subCategoryDirection == "asc" ? "desc" : "asc";
            return;
        }

        subCategorySort = column;
        subCategoryDirection = "asc";
    }

    private void CreateAttribute() => Navigation.NavigateTo("/admin/catalog/attributes/create");
    private void EditAttribute(int id) => Navigation.NavigateTo($"/admin/catalog/attributes/{id}/edit");

    private async Task DeleteAttributeAsync(int id)
    {
        await Api.DeleteAttributeAsync(id);
        message = "Atributo excluido.";
        await LoadAsync();
    }

    private Task SearchAttributesAsync() => Task.CompletedTask;

    private void SortAttributes(string column)
    {
        if (attributeSort == column)
        {
            attributeDirection = attributeDirection == "asc" ? "desc" : "asc";
            return;
        }

        attributeSort = column;
        attributeDirection = "asc";
    }

    private IEnumerable<AdminCategory> ApplyCategorySort(IEnumerable<AdminCategory> source) =>
        categorySort == "title" && categoryDirection == "desc"
            ? source.OrderByDescending(category => category.Title)
            : source.OrderBy(category => category.Title);

    private IEnumerable<AdminSubCategory> ApplySubCategorySort(IEnumerable<AdminSubCategory> source) =>
        subCategorySort switch
        {
            "category" when subCategoryDirection == "desc" => source.OrderByDescending(subCategory => subCategory.Category).ThenByDescending(subCategory => subCategory.Title),
            "category" => source.OrderBy(subCategory => subCategory.Category).ThenBy(subCategory => subCategory.Title),
            _ when subCategoryDirection == "desc" => source.OrderByDescending(subCategory => subCategory.Title),
            _ => source.OrderBy(subCategory => subCategory.Title)
        };

    private IEnumerable<AdminAttribute> ApplyAttributeSort(IEnumerable<AdminAttribute> source) =>
        attributeDirection == "desc"
            ? source.OrderByDescending(catalogAttribute => catalogAttribute.Name)
            : source.OrderBy(catalogAttribute => catalogAttribute.Name);

    private enum AdminCatalogTab
    {
        Categories,
        SubCategories,
        Attributes
    }

}
