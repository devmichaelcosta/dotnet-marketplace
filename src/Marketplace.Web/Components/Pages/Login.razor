@page "/login"
@rendermode InteractiveServer
@inject ClientState State
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>Login</PageTitle>

<section class="legacy-auth-shell">
    <div class="auth-shell-split auth-shell-login">
        <div class="auth-promo-panel">
            <span class="market-eyebrow">Marketplace premium</span>
            <h1>Entre e volte exatamente para onde parou</h1>
            <p>Continue sua navegacao, recupere o carrinho e acesse seus pedidos com um fluxo simples e seguro.</p>
            <div class="auth-promo-list">
                <div>
                    <strong>Checkout rapido</strong>
                    <span>Seus dados ficam prontos para a proxima compra.</span>
                </div>
                <div>
                    <strong>Pedidos e curtidos</strong>
                    <span>Acompanhe o que voce ja viu e comprou.</span>
                </div>
                <div>
                    <strong>Conta unificada</strong>
                    <span>Login, perfil e enderecos em um so lugar.</span>
                </div>
            </div>
        </div>

        @if (State.IsAuthenticated)
        {
            <div class="legacy-auth-card auth-card-panel">
                <span class="market-eyebrow text-center">Acesso ativo</span>
                <h2 class="auth-card-title">Voce ja esta logado como <strong>@State.UserName</strong></h2>
                <p class="muted text-center">Se quiser, pode sair agora e trocar de conta.</p>
                <button class="btn btn-lg btn-block btn-outline-dark w-100" data-testid="logout-button" @onclick="SignOutAsync">Sair</button>
            </div>
        }
        else
        {
            <EditForm Model="form" OnValidSubmit="SignInAsync" FormName="login-form" class="legacy-auth-card auth-card-panel" data-testid="login-form">
                <DataAnnotationsValidator />
                <span class="market-eyebrow text-center">Bem-vindo de volta</span>
                <h2 class="auth-card-title">Entre para continuar comprando</h2>
                <label>
                    Login
                    <InputText id="login" class="form-control" placeholder="Informe seu login" @bind-Value="form.Login" data-testid="login-username" />
                </label>
                <label>
                    Senha
                    <InputText id="password" class="form-control" type="password" placeholder="Informe sua senha" @bind-Value="form.Password" data-testid="login-password" />
                </label>
                <button class="btn btn-lg btn-block mt-2 btn-primary w-100" data-testid="login-submit" type="submit">Entrar</button>
                <div class="auth-links">
                    <a class="a-primary d-block text-center mt-3" href="register">Criar uma conta</a>
                    <a class="muted d-block text-center mt-2" href="recover-password">Esqueci minha senha</a>
                </div>
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <p class="text-danger" data-testid="login-error">@error</p>
                }
            </EditForm>
        }
    </div>
</section>

@code {
    private LoginForm form = new();
    private string? error;

    private async Task SignInAsync()
    {
        error = null;
        var result = await Js.InvokeAsync<WebLoginResult>("marketplaceSession.login", form.Login, form.Password);
        if (!result.Succeeded)
        {
            error = string.IsNullOrWhiteSpace(result.Message) ? "Login ou senha invalidos." : result.Message;
            return;
        }

        Navigation.NavigateTo("/", forceLoad: true);
    }

    private async Task SignOutAsync()
    {
        State.SignOut();
        await Js.InvokeVoidAsync("marketplaceSession.logout");
        Navigation.NavigateTo("/", forceLoad: true);
    }

    private sealed class LoginForm
    {
        public string Login { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
