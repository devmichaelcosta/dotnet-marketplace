@page "/admin/products"
@attribute [Authorize(Roles = "admin,vendedor")]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject NavigationManager Navigation
@inject IJSRuntime Js

<PageTitle>Produtos</PageTitle>

@if (loading)
{
    <section class="admin-imports-shell">
        <div class="admin-import-card">
            <p>Carregando produtos...</p>
        </div>
    </section>
}
else
{
    <section class="admin-imports-shell">
        <div class="admin-imports-hero">
            <div>
                <span>Admin</span>
                <h1>Produtos</h1>
                <p>Cadastro administrativo de produtos migrado para Blazor.</p>
            </div>
            <div>
                <a class="btn btn-primary" data-testid="admin-products-create" href="/admin/products/create">Novo produto</a>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="admin-toast @(successMessage ? "admin-toast-success" : "admin-toast-error")" data-testid="admin-products-notice" role="status" aria-live="polite">
                <div>
                    <strong>@(successMessage ? "Sucesso" : "Atencao")</strong>
                    <span>@message</span>
                </div>
                <button class="btn btn-sm btn-link admin-toast-close" type="button" @onclick="DismissMessage" aria-label="Fechar notificacao">
                    <i class="fa fa-times"></i>
                </button>
            </div>
        }

        <div class="admin-import-card admin-table-card">
            <div class="admin-table-header">
                <div>
                    <span class="admin-card-eyebrow">Lista</span>
                    <h2>Produtos cadastrados</h2>
                </div>
                <span class="admin-total-pill">@products.Total registros</span>
            </div>

            <form class="admin-filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <input class="form-control" data-testid="admin-products-search" placeholder="Buscar por titulo, descricao ou SKU" @bind="search" @bind:event="oninput" />
                <select class="form-control" value="@pageSize" @onchange="OnPageSizeChanged">
                    <option value="10">10 por pagina</option>
                    <option value="25">25 por pagina</option>
                    <option value="50">50 por pagina</option>
                </select>
                <button class="btn btn-primary" type="submit">Buscar</button>
            </form>

            <div class="admin-table-scroll">
                <table class="table admin-data-table" data-testid="admin-products-table">
                    <thead>
                        <tr>
                            <th class="actions-column admin-product-actions"></th>
                            <th><button class="table-sort" type="button" @onclick='() => SortAsync("title")'>Produto</button></th>
                            <th><button class="table-sort" type="button" @onclick='() => SortAsync("sku")'>SKU</button></th>
                            <th class="number-cell"><button class="table-sort" type="button" @onclick='() => SortAsync("stock")'>Estoque</button></th>
                            <th class="number-cell"><button class="table-sort" type="button" @onclick='() => SortAsync("price")'>Preco</button></th>
                            <th><button class="table-sort" type="button" @onclick='() => SortAsync("offer")'>Oferta</button></th>
                            <th><button class="table-sort" type="button" @onclick='() => SortAsync("seller")'>Vendedor</button></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in products.Items)
                        {
                            <tr data-testid="admin-products-row">
                                <td class="actions-column admin-product-actions">
                                    <div class="action-cell">
                                        <a class="btn btn-sm btn-outline-secondary icon-action" data-testid="admin-products-edit" title="Editar" href="@($"/admin/products/{product.Id}/edit")">
                                            <i class="fa fa-pen"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger icon-action" data-testid="admin-products-delete" type="button" title="Excluir" @onclick="() => DeleteAsync(product.Id)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </td>
                                <td>@product.Title</td>
                                <td>@product.Sku</td>
                                <td class="number-cell">@product.Stock</td>
                                <td class="number-cell">@product.Price.ToString("C")</td>
                                <td>@(product.Offer ? "Sim" : "Nao")</td>
                                <td>@product.Seller</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="pagination-row admin-pagination">
                <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@(currentPage <= 1)" @onclick="PreviousAsync">Anterior</button>
                <span>Pagina @currentPage de @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@(currentPage >= TotalPages)" @onclick="NextAsync">Proxima</button>
            </div>
        </div>
    </section>
}

@code {
    private AdminProductSearchResponse products = new([], 0, 1, 10);
    private bool loading;
    private string? message;
    private bool successMessage;
    private string search = string.Empty;
    private string sort = "title";
    private string direction = "asc";
    private int currentPage = 1;
    private int pageSize = 10;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(products.Total / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.Uri.Contains("saved=created", StringComparison.OrdinalIgnoreCase))
        {
            message = "Produto cadastrado com sucesso.";
            successMessage = true;
        }

        if (Navigation.Uri.Contains("saved=edited", StringComparison.OrdinalIgnoreCase))
        {
            message = "Produto editado com sucesso.";
            successMessage = true;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        products = await Api.GetAdminProductsAsync(search, currentPage, pageSize, sort, direction) ?? new AdminProductSearchResponse([], 0, currentPage, pageSize);
        loading = false;
    }

    private async Task SearchAsync()
    {
        currentPage = 1;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs args)
    {
        if (int.TryParse(args.Value?.ToString(), out var value) && value > 0)
        {
            pageSize = value;
        }

        currentPage = 1;
        await LoadAsync();
    }

    private async Task SortAsync(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
        }
        else
        {
            sort = column;
            direction = "asc";
        }

        currentPage = 1;
        await LoadAsync();
    }

    private async Task PreviousAsync()
    {
        currentPage--;
        await LoadAsync();
    }

    private async Task NextAsync()
    {
        currentPage++;
        await LoadAsync();
    }

    private async Task DeleteAsync(int id)
    {
        var product = products.Items.FirstOrDefault(item => item.Id == id);
        if (product is not null)
        {
            var confirmed = await Js.InvokeAsync<bool>("confirm", $"Excluir o produto {product.Title}? Esta acao nao pode ser desfeita.");
            if (!confirmed)
            {
                return;
            }
        }

        var result = await Api.DeleteProductAsync(id);
        message = result.Message;
        successMessage = result.Succeeded;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private void DismissMessage() => message = null;
}
