@page "/admin/users"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State
@inject IJSRuntime Js
@inject NavigationManager Navigation

<PageTitle>Usuarios</PageTitle>

@if (loading)
{
    <section class="admin-imports-shell">
        <div class="admin-import-card">
            <p>Carregando usuarios...</p>
        </div>
    </section>
}
else
{
    <section class="admin-imports-shell admin-catalog-shell">
        <div class="admin-imports-hero">
            <div>
                <span>Admin</span>
                <h1>Usuarios</h1>
                <p>Gerencie contas, perfis de acesso e reset de senha no mesmo padrao visual do admin.</p>
            </div>
            <div>
                <a class="btn btn-primary" href="/admin/users/create">Novo usuario</a>
            </div>
        </div>

        @if (!State.IsAuthenticated || !State.IsAdmin)
        {
            <div class="admin-import-card">Faca login como admin para acessar esta area.</div>
        }
        else
        {
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="admin-toast @(successMessage ? "admin-toast-success" : "admin-toast-error")" role="status" aria-live="polite">
                    <div>
                        <strong>@(successMessage ? "Sucesso" : "Atencao")</strong>
                        <span>@message</span>
                    </div>
                    <button class="btn btn-sm btn-link admin-toast-close" type="button" @onclick="DismissMessage" aria-label="Fechar notificacao">
                        <i class="fa fa-times"></i>
                    </button>
                </div>
            }

            <section class="admin-import-card admin-table-card">
                <div class="admin-table-header">
                    <div>
                        <span class="admin-card-eyebrow">Lista</span>
                        <h2>Usuarios cadastrados</h2>
                    </div>
                    <span class="admin-total-pill">@users.Length registros</span>
                </div>

                <form class="admin-filter-bar admin-catalog-filter" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                    <input class="form-control" placeholder="Buscar por usuario, login, perfil ou CPF" @bind="search" @bind:event="oninput" />
                    <button class="btn btn-primary" type="submit">Buscar</button>
                </form>

                <div class="admin-table-scroll">
                    <table class="table admin-data-table">
                        <thead>
                            <tr>
                                <th class="actions-column"></th>
                                <th><button class="table-sort" type="button" @onclick='() => SortAsync("name")'>Usuario</button></th>
                                <th><button class="table-sort" type="button" @onclick='() => SortAsync("login")'>Login</button></th>
                                <th><button class="table-sort" type="button" @onclick='() => SortAsync("role")'>Perfil</button></th>
                                <th><button class="table-sort" type="button" @onclick='() => SortAsync("cpf")'>CPF</button></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                <tr>
                                    <td class="actions-column">
                                        <div class="action-cell">
                                            <a class="btn btn-sm btn-outline-secondary icon-action" title="Editar" href="@($"/admin/users/{user.Id}/edit")">
                                                <i class="fa fa-pen"></i>
                                            </a>
                                            <a class="btn btn-sm btn-outline-warning icon-action" title="Resetar senha" href="@($"/admin/users/{user.Id}/password")">
                                                <i class="fa fa-key"></i>
                                            </a>
                                            <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteAsync(user.Id)">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td>@FullName(user)</td>
                                    <td>@user.Login</td>
                                    <td>@user.Role</td>
                                    <td>@(string.IsNullOrWhiteSpace(user.Cpf) ? "-" : user.Cpf)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    </section>
}

@code {
    private bool loading;
    private string? message;
    private bool successMessage;
    private AdminUser[] users = [];
    private string search = string.Empty;
    private string sort = "name";
    private string direction = "asc";

    protected override async Task OnInitializedAsync()
    {
        if (Navigation.Uri.Contains("saved=user", StringComparison.OrdinalIgnoreCase))
        {
            message = "Usuario salvo com sucesso.";
            successMessage = true;
        }
        else if (Navigation.Uri.Contains("saved=password", StringComparison.OrdinalIgnoreCase))
        {
            message = "Senha redefinida com sucesso.";
            successMessage = true;
        }

        if (State.IsAdmin)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        users = await Api.GetAdminUsersAsync(search, sort, direction);
        loading = false;
    }

    private async Task SearchAsync() => await LoadAsync();

    private async Task SortAsync(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
        }
        else
        {
            sort = column;
            direction = "asc";
        }

        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var user = users.FirstOrDefault(item => item.Id == id);
        if (user is not null)
        {
            var confirmed = await Js.InvokeAsync<bool>("confirm", $"Excluir o usuario {FullName(user)}? Esta acao nao pode ser desfeita.");
            if (!confirmed)
            {
                return;
            }
        }

        var result = await Api.DeleteUserAsync(id);
        message = result.Message;
        successMessage = result.Succeeded;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private static string FullName(AdminUser user)
    {
        var fullName = $"{user.Name} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(fullName) ? user.Login : fullName;
    }

    private void DismissMessage() => message = null;
}
