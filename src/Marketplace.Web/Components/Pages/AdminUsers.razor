@page "/admin/users"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State
@inject IJSRuntime Js

<PageTitle>Usuarios</PageTitle>

<div class="toolbar">
    <div>
        <h1>Usuarios</h1>
        <p>Contas, dados basicos e perfil de acesso.</p>
    </div>
</div>

@if (!State.IsAuthenticated || !State.IsAdmin)
{
    <p>Faca login como admin para acessar esta area.</p>
}
else if (loading)
{
    <p>Carregando usuarios...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="notice @(successMessage ? "notice-success" : null)">@message</p>
    }

    <section class="admin-grid">
        <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="user-form" class="form-panel wide-form">
            <DataAnnotationsValidator />
            <h2>@(form.Id is null ? "Novo usuario" : "Editar usuario")</h2>
            <label>
                Nome
                <InputText class="form-control" @bind-Value="form.Name" />
            </label>
            <label>
                Sobrenome
                <InputText class="form-control" @bind-Value="form.LastName" />
            </label>
            <label>
                Login
                <InputText class="form-control" @bind-Value="form.Login" />
            </label>
            <label>
                CPF
                <InputText class="form-control" @bind-Value="form.Cpf" />
            </label>
            <label>
                Perfil
                <InputSelect class="form-control" @bind-Value="form.Role">
                    <option value="comum">Comum</option>
                    <option value="vendedor">Vendedor</option>
                    <option value="admin">Admin</option>
                </InputSelect>
            </label>
            @if (form.Id is null)
            {
                <label>
                    Senha
                    <InputText class="form-control" type="password" @bind-Value="form.Password" />
                </label>
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Salvar</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">Limpar</button>
            </div>
        </EditForm>

        @if (passwordForm.UserId is not null)
        {
            <EditForm Model="passwordForm" OnValidSubmit="ResetPasswordAsync" FormName="reset-user-password-form" class="form-panel wide-form">
                <DataAnnotationsValidator />
                <h2>Resetar senha</h2>
                <p class="notice">Usuario: @passwordForm.UserName</p>
                <label>
                    Nova senha
                    <InputText class="form-control" type="password" @bind-Value="passwordForm.Password" />
                </label>
                <div class="form-actions">
                    <button class="btn btn-primary" type="submit">Resetar senha</button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelPasswordReset">Cancelar</button>
                </div>
            </EditForm>
        }

        <div class="table-panel">
            <form class="admin-filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <input class="form-control" placeholder="Buscar por usuario, login, perfil ou CPF" @bind="search" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" type="submit">Buscar</button>
            </form>

            <table class="table admin-data-table">
                <thead>
                    <tr>
                        <th></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortUsers("name")'>Usuario</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortUsers("login")'>Login</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortUsers("role")'>Perfil</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortUsers("cpf")'>CPF</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="actions-column">
                                <div class="action-cell">
                                    <button class="btn btn-sm btn-outline-secondary icon-action" type="button" title="Editar" @onclick="() => Edit(user)">
                                        <i class="fa fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-warning icon-action" type="button" title="Resetar senha" @onclick="() => StartPasswordReset(user)">
                                        <i class="fa fa-key"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteAsync(user.Id)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                            <td>@user.Name @user.LastName</td>
                            <td>@user.Login</td>
                            <td>@user.Role</td>
                            <td>@user.Cpf</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private bool loading;
    private string? message;
    private bool successMessage;
    private AdminUser[] users = [];
    private UserForm form = new();
    private PasswordResetForm passwordForm = new();
    private string search = string.Empty;
    private string sort = "name";
    private string direction = "asc";

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAdmin)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        users = await Api.GetAdminUsersAsync(search, sort, direction);
        loading = false;
    }

    private async Task SearchAsync() => await LoadAsync();

    private async Task SortUsers(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
        }
        else
        {
            sort = column;
            direction = "asc";
        }

        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.Name) || string.IsNullOrWhiteSpace(form.Login))
        {
            message = "Informe nome e login.";
            successMessage = false;
            return;
        }

        if (form.Id is null && string.IsNullOrWhiteSpace(form.Password))
        {
            message = "Senha obrigatoria para novo usuario.";
            successMessage = false;
            return;
        }

        var result = await Api.SaveUserAsync(new AdminUserRequest(form.Id, form.Name.Trim(), form.LastName.Trim(), form.Login.Trim(), form.Password, form.Cpf, form.Role));
        message = result.Message;
        successMessage = result.Succeeded;
        if (result.Succeeded)
        {
            ResetForm();
            await LoadAsync();
        }
    }

    private void Edit(AdminUser user)
    {
        form = new UserForm
        {
            Id = user.Id,
            Name = user.Name,
            LastName = user.LastName,
            Login = user.Login,
            Cpf = user.Cpf,
            Role = user.Role
        };
    }

    private void StartPasswordReset(AdminUser user)
    {
        passwordForm = new PasswordResetForm
        {
            UserId = user.Id,
            UserName = $"{user.Name} {user.LastName}".Trim()
        };
    }

    private async Task ResetPasswordAsync()
    {
        if (passwordForm.UserId is null)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(passwordForm.Password))
        {
            message = "Informe a nova senha.";
            successMessage = false;
            return;
        }

        var result = await Api.ResetUserPasswordAsync(passwordForm.UserId.Value, passwordForm.Password);
        message = result.Message;
        successMessage = result.Succeeded;
        if (result.Succeeded)
        {
            CancelPasswordReset();
        }
    }

    private void CancelPasswordReset()
    {
        passwordForm = new PasswordResetForm();
    }

    private async Task DeleteAsync(Guid id)
    {
        var user = users.FirstOrDefault(item => item.Id == id);
        if (user is not null)
        {
            var confirmed = await Js.InvokeAsync<bool>("confirm", $"Excluir o usuario {user.Name} {user.LastName}? Esta acao nao pode ser desfeita.");
            if (!confirmed)
            {
                return;
            }
        }

        var result = await Api.DeleteUserAsync(id);
        message = result.Message;
        successMessage = result.Succeeded;
        if (result.Succeeded)
        {
            await LoadAsync();
        }
    }

    private void ResetForm()
    {
        form = new UserForm();
    }
    private sealed class UserForm
    {
        public Guid? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Login { get; set; } = string.Empty;
        public string? Password { get; set; }
        public string? Cpf { get; set; }
        public string Role { get; set; } = "comum";
    }

    private sealed class PasswordResetForm
    {
        public Guid? UserId { get; set; }
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
