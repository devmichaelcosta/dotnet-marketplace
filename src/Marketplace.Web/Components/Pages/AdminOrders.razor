@page "/admin/orders"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State

<PageTitle>Pedidos</PageTitle>

<div class="toolbar">
    <div>
        <h1>Pedidos</h1>
        <p>Consulta administrativa de compras realizadas.</p>
    </div>
</div>

@if (!State.IsAuthenticated || !State.IsAdmin)
{
    <p>Faca login como admin para acessar esta area.</p>
}
else if (loading)
{
    <p>Carregando pedidos...</p>
}
else
{
    <section class="orders-layout">
        <div class="table-panel compact">
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="notice @(successMessage ? "notice-success" : null)">@message</p>
            }

            <form class="admin-filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <input class="form-control" placeholder="Cliente, login ou cidade" @bind="search" @bind:event="oninput" />
                <button class="btn btn-primary" type="submit">Buscar</button>
            </form>

            <table class="table admin-data-table">
                <thead>
                    <tr>
                        <th><button class="table-sort" type="button" @onclick='() => SortOrders("id")'>Pedido</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortOrders("customer")'>Cliente</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortOrders("city")'>Cidade</button></th>
                        <th class="number-cell"><button class="table-sort" type="button" @onclick='() => SortOrders("total")'>Total</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortOrders("created")'>Data</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr class="selectable-row" @onclick="() => SelectAsync(order.Id)">
                            <td>#@order.Id</td>
                            <td>@order.UserName <small class="muted">(@order.Login)</small></td>
                            <td>@order.City</td>
                            <td>@order.Total.ToString("C")</td>
                            <td>@order.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <aside class="order-details">
            @if (selected is null)
            {
                <p>Selecione um pedido.</p>
            }
            else
            {
                <h2>Pedido #@selected.Id</h2>
                <p><strong>Cliente:</strong> @selected.Name (@selected.Login)</p>
                <p><strong>Endereco:</strong> @selected.Address, @selected.Neighborhood - @selected.City/@selected.State</p>
                <p><strong>CEP:</strong> @selected.Cep</p>
                @if (!string.IsNullOrWhiteSpace(selected.Complement))
                {
                    <p><strong>Complemento:</strong> @selected.Complement</p>
                }
                <table class="table">
                    <thead>
                        <tr>
                            <th>Produto</th>
                            <th>Qtd</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in selected.Items)
                        {
                            <tr>
                                <td>@item.Title</td>
                                <td>@item.Quantity</td>
                                <td>@item.SubTotal.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <strong>Total: @selected.Total.ToString("C")</strong>
            }
        </aside>
    </section>
}

@code {
    private bool loading;
    private string? message;
    private bool successMessage;
    private string? search;
    private AdminOrderSummary[] orders = [];
    private AdminOrderDetails? selected;
    private string sort = "created";
    private string direction = "desc";

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAdmin)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        message = null;
        selected = null;
        orders = await Api.GetAdminOrdersAsync(search, sort, direction);
        loading = false;
    }

    private async Task SearchAsync() => await LoadAsync();

    private async Task SortOrders(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
        }

        if (sort != column)
        {
            sort = column;
            direction = "asc";
        }

        await LoadAsync();
    }

    private async Task SelectAsync(int id)
    {
        selected = await Api.GetAdminOrderDetailsAsync(id);
        if (selected is null)
        {
            message = "Nao foi possivel carregar os detalhes do pedido.";
            successMessage = false;
        }
    }

}
