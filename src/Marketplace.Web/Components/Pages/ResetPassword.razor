@page "/reset-password"
@rendermode InteractiveServer
@inject MarketplaceApiClient Api

<PageTitle>Redefinir senha</PageTitle>

<section class="legacy-auth-shell">
    <div class="auth-shell-split auth-shell-recover">
        <div class="auth-promo-panel auth-promo-panel-soft">
            <span class="market-eyebrow">Recuperacao segura</span>
            <h1>Escolha uma nova senha para sua conta</h1>
            <p>O link recebido por email e temporario e pode ser utilizado uma unica vez.</p>
        </div>

        <div class="legacy-auth-card auth-card-panel">
            <span class="market-eyebrow text-center">Nova senha</span>
            <h2 class="auth-card-title">Redefina sua senha</h2>
            @if (string.IsNullOrWhiteSpace(Login) || string.IsNullOrWhiteSpace(Token))
            {
                <p class="text-danger" role="alert" data-testid="reset-password-error">O link de redefinicao e invalido ou incompleto. Solicite um novo link.</p>
                <a class="btn btn-primary w-100" href="recover-password">Solicitar novo link</a>
            }
            else if (completed)
            {
                <p class="notice" role="status" data-testid="reset-password-success">@message</p>
                <a class="btn btn-primary w-100" href="login">Ir para o login</a>
            }
            else
            {
                <EditForm Model="form" OnValidSubmit="ConfirmResetAsync" FormName="reset-password-form" data-testid="reset-password-form">
                    <DataAnnotationsValidator />
                    <label for="new-password">Nova senha</label>
                    <InputText id="new-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="form.NewPassword" data-testid="reset-password-new" />
                    <ValidationMessage For="() => form.NewPassword" />
                    <label for="confirm-password" class="mt-2">Confirme a nova senha</label>
                    <InputText id="confirm-password" class="form-control" type="password" autocomplete="new-password" @bind-Value="form.ConfirmPassword" data-testid="reset-password-confirm" />
                    <ValidationMessage For="() => form.ConfirmPassword" />
                    <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@isBusy" data-testid="reset-password-submit">
                        @(isBusy ? "Salvando..." : "Redefinir senha")
                    </button>
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <p class="text-danger mt-2" role="alert" data-testid="reset-password-error">@message</p>
                    }
                </EditForm>
            }
        </div>
    </div>
</section>

@code {
    [SupplyParameterFromQuery(Name = "login")]
    public string? Login { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private ResetForm form = new();
    private string? message;
    private bool completed;
    private bool isBusy;

    private async Task ConfirmResetAsync()
    {
        if (isBusy || string.IsNullOrWhiteSpace(Login) || string.IsNullOrWhiteSpace(Token))
        {
            return;
        }

        isBusy = true;
        message = null;
        try
        {
            var result = await Api.ResetPasswordAsync(Login, Token, form.NewPassword);
            completed = result.Succeeded;
            message = result.Message;
        }
        catch (HttpRequestException)
        {
            message = "Nao foi possivel redefinir a senha agora. Tente novamente mais tarde.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class ResetForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe a nova senha.")]
        [System.ComponentModel.DataAnnotations.MinLength(6, ErrorMessage = "Use pelo menos 6 caracteres.")]
        [System.ComponentModel.DataAnnotations.RegularExpression("^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).+$", ErrorMessage = "A senha deve incluir letra maiuscula, letra minuscula e numero.")]
        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Confirme a nova senha.")]
        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "As senhas nao conferem.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}