@page "/orders"
@attribute [Authorize]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State

<PageTitle>Minhas compras</PageTitle>

<nav class="nav-breadcrumb admin-breadcrumb">
    <a href="/">Compras</a>
    <span>Lista de compras</span>
</nav>

<section class="admin-imports-shell orders-shell">
    <div class="admin-imports-hero">
        <div>
            <span>Compras</span>
            <h1>Lista de compras</h1>
            <p>Historico das suas compras e detalhe do pedido selecionado.</p>
        </div>
    </div>

    @if (!State.IsAuthenticated)
    {
        <div class="admin-import-card">Faca login para consultar seus pedidos.</div>
    }
    else if (orders is null)
    {
        <div class="admin-import-card">Carregando pedidos...</div>
    }
    else if (orders.Length == 0)
    {
        <div class="admin-import-card">Nenhum pedido encontrado.</div>
    }
    else
    {
        <div class="orders-layout">
            <div class="admin-import-card admin-table-card">
                <div class="admin-table-header">
                    <div>
                        <span class="admin-card-eyebrow">Pedidos</span>
                        <h2>Veja abaixo as compras disponiveis</h2>
                    </div>
                </div>

                <table class="table admin-data-table">
                    <thead>
                        <tr>
                            <th>Pedido</th>
                            <th>Data</th>
                            <th>Entrega</th>
                            <th class="number-cell">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr class="selectable-row" @onclick="() => LoadDetailsAsync(order.Id)">
                                <td>#@order.Id</td>
                                <td>@order.CreatedAt.LocalDateTime.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@order.Name - @order.City</td>
                                <td class="number-cell">@order.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (details is not null)
            {
                <aside class="admin-import-card order-details">
                    <div class="admin-table-header">
                        <div>
                            <span class="admin-card-eyebrow">Detalhe</span>
                            <h2>Pedido #@details.Id</h2>
                        </div>
                    </div>
                    <p>@details.Address, @details.Neighborhood - @details.City/@details.State</p>
                    @if (!string.IsNullOrWhiteSpace(details.Complement))
                    {
                        <p>@details.Complement</p>
                    }

                    @foreach (var item in details.Items)
                    {
                        <div class="cart-row compact">
                            <span>@item.Title</span>
                            <span>@item.Quantity x @item.UnitPrice.ToString("C")</span>
                            <strong>@item.SubTotal.ToString("C")</strong>
                        </div>
                    }

                    <div class="cart-total compact">
                        <span>Total</span>
                        <strong>@details.Total.ToString("C")</strong>
                    </div>
                </aside>
            }
        </div>
    }
</section>

@code {
    private OrderSummary[]? orders;
    private OrderDetails? details;

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAuthenticated)
        {
            orders = await Api.GetOrdersAsync();
        }
    }

    private async Task LoadDetailsAsync(int id)
    {
        details = await Api.GetOrderDetailsAsync(id);
    }
}
