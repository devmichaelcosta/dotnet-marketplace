@page "/admin/carousel"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@inject MarketplaceApiClient Api
@inject ClientState State

<PageTitle>Destaques</PageTitle>

<div class="toolbar">
    <div>
        <h1>Destaques</h1>
        <p>Imagens do carousel da home.</p>
    </div>
</div>

@if (!State.IsAuthenticated)
{
    <p>Faca login como admin para acessar esta area.</p>
}
else if (loading)
{
    <p>Carregando destaques...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="notice">@message</p>
    }

    <section class="admin-grid">
        <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="carousel-form" class="form-panel wide-form">
            <DataAnnotationsValidator />
            <h2>@(form.Id is null ? "Novo destaque" : "Editar destaque")</h2>
            <label>
                Imagem
                <InputText class="form-control" @bind-Value="form.FileName" />
            </label>
            <InputFile OnChange="UploadAsync" accept="image/*" />
            <label>
                Ordem
                <InputNumber class="form-control" @bind-Value="form.SortOrder" />
            </label>
            @if (!string.IsNullOrWhiteSpace(form.FileName))
            {
                <img class="admin-preview" src="@Api.AssetUrl(form.FileName)" alt="Preview do destaque" />
            }
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Salvar</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">Limpar</button>
            </div>
        </EditForm>

        <div class="table-panel">
            <form class="admin-filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <input class="form-control" placeholder="Buscar por nome do arquivo ou ordem" @bind="search" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" type="submit">Buscar</button>
            </form>

            <table class="table admin-data-table">
                <thead>
                    <tr>
                        <th></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortCarousel("file")'>Imagem</button></th>
                        <th class="number-cell"><button class="table-sort" type="button" @onclick='() => SortCarousel("order")'>Ordem</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var image in FilteredCarousel)
                    {
                        <tr>
                            <td class="actions-column">
                                <div class="action-cell">
                                    <button class="btn btn-sm btn-outline-secondary icon-action" type="button" title="Editar" @onclick="() => Edit(image)">
                                        <i class="fa fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteAsync(image.Id)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                            <td>
                                <img class="thumb" src="@Api.AssetUrl(image.FileName)" alt="Destaque" />
                                <span>@image.FileName</span>
                            </td>
                            <td>@image.SortOrder</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private bool loading;
    private string? message;
    private AdminCarouselImage[] carousel = [];
    private CarouselForm form = new();
    private string search = string.Empty;
    private string sort = "order";
    private string direction = "asc";

    private IEnumerable<AdminCarouselImage> FilteredCarousel =>
        ApplySort(carousel.Where(image =>
            string.IsNullOrWhiteSpace(search) ||
            image.FileName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            image.SortOrder.ToString().Contains(search, StringComparison.OrdinalIgnoreCase)));

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAuthenticated)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        carousel = await Api.GetCarouselAsync();
        loading = false;
    }

    private async Task SearchAsync() => await LoadAsync();

    private void SortCarousel(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
            return;
        }

        sort = column;
        direction = "asc";
    }

    private async Task UploadAsync(InputFileChangeEventArgs args)
    {
        var result = await Api.UploadImageAsync("carousel", args.File);
        if (result is null)
        {
            message = "Nao foi possivel enviar a imagem.";
            return;
        }

        form.FileName = result.Url;
        message = "Imagem enviada.";
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(form.FileName))
        {
            message = "Informe uma imagem.";
            return;
        }

        await Api.SaveCarouselAsync(new AdminCarouselRequest(form.Id, form.FileName.Trim(), form.SortOrder));
        message = "Destaque salvo.";
        ResetForm();
        await LoadAsync();
    }

    private void Edit(AdminCarouselImage image)
    {
        form = new CarouselForm { Id = image.Id, FileName = image.FileName, SortOrder = image.SortOrder };
    }

    private async Task DeleteAsync(int id)
    {
        await Api.DeleteCarouselAsync(id);
        message = "Destaque excluido.";
        await LoadAsync();
    }

    private void ResetForm()
    {
        form = new CarouselForm();
    }

    private IEnumerable<AdminCarouselImage> ApplySort(IEnumerable<AdminCarouselImage> source) =>
        (sort, direction) switch
        {
            ("file", "desc") => source.OrderByDescending(image => image.FileName),
            ("file", _) => source.OrderBy(image => image.FileName),
            ("order", "desc") => source.OrderByDescending(image => image.SortOrder),
            _ => source.OrderBy(image => image.SortOrder)
        };

    private sealed class CarouselForm
    {
        public int? Id { get; set; }
        public string FileName { get; set; } = string.Empty;
        public int SortOrder { get; set; }
    }
}
