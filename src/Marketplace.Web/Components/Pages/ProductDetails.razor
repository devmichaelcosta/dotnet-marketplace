@page "/products/{Id:int}"
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State

<PageTitle>Produto</PageTitle>

@if (details is null)
{
    <p>Carregando produto...</p>
}
else
{
    <nav class="nav-breadcrumb nav-breadcrumb-dark">
        <a href="/">Home</a>
        <span>@details.Product.Category</span>
        <span>@details.Product.SubCategory</span>
    </nav>

    <section class="product-hero-shell">
        <div class="product-hero-copy">
            <span class="market-eyebrow">Detalhe do produto</span>
            <h1>@details.Product.Title</h1>
            <p>@details.Product.Description</p>
            <div class="product-meta-row">
                <span class="product-meta-chip">SKU @details.Product.Sku</span>
                <span class="product-meta-chip">@details.Product.Seller</span>
                <span class="product-meta-chip">@details.Product.Ratings.Length avaliações</span>
            </div>
        </div>
        <div class="product-hero-card">
            <div class="market-hero-card-top">
                <span class="market-eyebrow">Compra segura</span>
                <strong>@(details.Product.Stock > 0 ? "Disponível para envio imediato" : "Indisponível no momento")</strong>
            </div>
            <div class="product-hero-price">@details.Product.Price.ToString("C")</div>
            <div class="product-hero-subtitle">em 1x no cartão</div>
            <div class="market-hero-actions">
                @if (details.Product.Stock > 0)
                {
                    <button class="btn btn-primary w-100" @onclick="AddToCartAsync">Adicionar no carrinho</button>
                }
                else
                {
                    <button class="btn btn-outline-secondary w-100" type="button" disabled>Sem estoque</button>
                }
                @if (State.IsAuthenticated)
                {
                    <button class="btn btn-outline-secondary w-100" type="button" title="Curtir" aria-label="Curtir produto" @onclick="LikeAsync">Curtir produto</button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="notice product-message">@message</p>
            }
        </div>
    </section>

    <section id="detalhes-produto" class="legacy-product-card product-details-card">
        <div class="legacy-product-gallery">
            <div class="legacy-product-main-image">
                @if (SelectedImage is null)
                {
                    <span>produto</span>
                }
                else
                {
                    <img src="@Api.AssetUrl(SelectedImage)" alt="@details.Product.Title" loading="lazy" />
                }
            </div>
            @if (details.Product.Images.Length > 1)
            {
                <div class="slider-nav-produto">
                    @foreach (var image in details.Product.Images)
                    {
                        <button class="@(image == SelectedImage ? "active" : null)" type="button" @onclick="() => SelectImage(image)">
                            <img src="@Api.AssetUrl(image)" alt="@details.Product.Title" loading="lazy" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="legacy-product-info">
            <div class="legacy-product-title-row">
                <h2>Visao geral</h2>
                <span class="product-stock-chip">Qtd. estoque: @details.Product.Stock</span>
            </div>
            <div class="sku">(Cod. @details.Product.Sku)</div>
            <div class="vendedor">Vendido por: <strong>@details.Product.Seller</strong></div>
            @if (VariationAttributes.Length > 0)
            {
                <div class="product-variation-panel">
                    <span>Variações disponiveis</span>
                    <div>
                        @foreach (var productAttribute in VariationAttributes)
                        {
                            <button type="button">@productAttribute.Attribute: @productAttribute.Value</button>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    if (!string.IsNullOrEmpty(details.Product.Description))
    {
        <section>
            <h3 class="mt-3">Informações do produto</h3>
            <div class="legacy-info-card">
                <p>@details.Product.Description</p>
            </div>
        </section>
    }

    @if (details.SimilarProducts.Length > 0)
    {
        <section>
            <h3 class="mt-3">Produtos semelhantes</h3>
            <div class="similar-products-slider legacy-products-row">
                @foreach (var product in details.SimilarProducts)
                {
                    <ProductCard Product="product" />
                }
            </div>
        </section>
    }

    @if (details.Product.Attributes.Length > 0)
    {
        <section class="product-section-block">
            <h3 class="mt-3">Ficha tecnica</h3>

            <div class="legacy-info-card">

                <div class="product-attribute-grid">
                    @foreach (var productAttribute in details.Product.Attributes)
                    {
                        <div class="product-attribute-chip">
                            <span>@productAttribute.Attribute</span>
                            <strong>@productAttribute.Value</strong>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <section class="product-section-block">
        <h3 class="mt-3">Avaliações</h3>

        <div class="legacy-info-card">
        @if (details.Product.Ratings.Length == 0)
        {
            <p>Nenhuma avaliação aprovada.</p>
        }
        else
        {
            @foreach (var rating in details.Product.Ratings)
            {
                <article class="review-row">
                    <strong>@rating.Title</strong>
                    <span>@rating.Rating</span>
                    <p>@rating.Description</p>
                </article>
            }
        }
        </div>

        @if (State.IsAuthenticated)
        {
            <EditForm Model="ratingForm" OnValidSubmit="SubmitRatingAsync" FormName="rating-form" class="form-panel wide-form rating-form">
                <DataAnnotationsValidator />
                <h3>Avaliar produto</h3>
                <label>
                    Título
                    <InputText class="form-control" @bind-Value="ratingForm.Title" />
                </label>
                <label>
                    Nota
                    <InputText class="form-control" @bind-Value="ratingForm.Rating" />
                </label>
                <label>
                    Descrição
                    <InputTextArea class="form-control" @bind-Value="ratingForm.Description" />
                </label>
                <label class="form-check-row">
                    <InputCheckbox class="form-check-input" @bind-Value="ratingForm.Recommended" />
                    Recomendo este produto
                </label>
                <button class="btn btn-primary" type="submit">Enviar avaliação</button>
            </EditForm>
        }
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private ProductDetailsResponse? details;
    private string? message;
    private string? selectedImage;
    private RatingForm ratingForm = new();

    private string? SelectedImage => selectedImage ?? details?.Product.Images.FirstOrDefault();
    private ProductAttributeValue[] VariationAttributes => details?.Product.Attributes
        .Where(item => IsVariationAttribute(item.Attribute))
        .ToArray() ?? [];

    protected override async Task OnParametersSetAsync()
    {
        details = await Api.GetProductDetailsAsync(Id);
        selectedImage = details?.Product.Images.FirstOrDefault();
    }

    private void SelectImage(string image)
    {
        selectedImage = image;
    }

    private async Task AddToCartAsync()
    {
        var cart = await Api.AddToCartAsync(Id);
        message = cart?.Items.Any(item => item.ProductId == Id) == true
            ? "Produto adicionado ao carrinho."
            : "Não foi possível confirmar o item no carrinho.";
        State.NotifyChanged();
    }

    private async Task LikeAsync()
    {
        await Api.LikeProductAsync(Id);
        message = "Produto curtido.";
    }

    private async Task SubmitRatingAsync()
    {
        if (string.IsNullOrWhiteSpace(ratingForm.Title) || string.IsNullOrWhiteSpace(ratingForm.Description))
        {
            message = "Informe título e descrição da avaliação.";
            return;
        }

        await Api.SubmitRatingAsync(Id, new RatingRequest(ratingForm.Title.Trim(), ratingForm.Description.Trim(), ratingForm.Recommended, ratingForm.Rating.Trim()));
        ratingForm = new RatingForm();
        message = "Avaliação enviada para aprovação.";
    }

    private static bool IsVariationAttribute(string name) =>
        name.Contains("cor", StringComparison.OrdinalIgnoreCase)
        || name.Contains("tamanho", StringComparison.OrdinalIgnoreCase)
        || name.Contains("voltagem", StringComparison.OrdinalIgnoreCase)
        || name.Contains("material", StringComparison.OrdinalIgnoreCase)
        || name.Contains("marca", StringComparison.OrdinalIgnoreCase)
        || name.Contains("modelo", StringComparison.OrdinalIgnoreCase);

    private sealed class RatingForm
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Rating { get; set; } = "5";
        public bool Recommended { get; set; } = true;
    }
}

