@page "/admin/sellers"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State
@inject IJSRuntime Js

<PageTitle>Vendedores</PageTitle>

<div class="toolbar">
    <div>
        <h1>Vendedores</h1>
        <p>Dados comerciais e pessoais dos vendedores.</p>
    </div>
</div>

@if (!State.IsAuthenticated || !State.IsAdmin)
{
    <p>Faca login como admin para acessar esta area.</p>
}
else if (loading)
{
    <p>Carregando vendedores...</p>
}
else
{
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="notice @(successMessage ? "notice-success" : null)">@message</p>
    }

    <section class="admin-grid">
        <EditForm Model="form" OnValidSubmit="SaveAsync" FormName="seller-form" class="form-panel wide-form">
            <DataAnnotationsValidator />
            <h2>@(form.Id is null ? "Novo vendedor" : "Editar vendedor")</h2>
            <label>
                Nome
                <InputText class="form-control" @bind-Value="form.Name" />
            </label>
            <label>
                Sobrenome
                <InputText class="form-control" @bind-Value="form.LastName" />
            </label>
            @if (form.Id is null)
            {
                <div class="checkout-grid compact-grid">
                    <label>
                        Login
                        <InputText class="form-control" @bind-Value="form.Login" />
                    </label>
                    <label>
                        Senha
                        <InputText class="form-control" type="password" @bind-Value="form.Password" />
                    </label>
                </div>
            }
            <div class="checkout-grid compact-grid">
                <label>
                    CPF
                    <InputText class="form-control" @bind-Value="form.Cpf" />
                </label>
                <label>
                    Idade
                    <InputNumber class="form-control" @bind-Value="form.Age" />
                </label>
                <label>
                    Data de nascimento
                    <InputText class="form-control" placeholder="yyyy-MM-dd" @bind-Value="form.DateOfBirthText" />
                </label>
                <label>
                    Email comercial
                    <InputText class="form-control" @bind-Value="form.Email" />
                </label>
            </div>
            <label>
                Website
                <InputText class="form-control" @bind-Value="form.Website" />
            </label>
            <label>
                Empresa
                <InputText class="form-control" @bind-Value="form.Company" />
            </label>
            <label>
                Nome fantasia
                <InputText class="form-control" @bind-Value="form.FantasyName" />
            </label>
            <label>
                CNPJ
                <InputText class="form-control" @bind-Value="form.Cnpj" />
            </label>
            <label>
                Ramo de atividade
                <InputText class="form-control" @bind-Value="form.BranchOfActivity" />
            </label>
            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Salvar</button>
                <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">Limpar</button>
            </div>
        </EditForm>

        <div class="table-panel">
            <form class="admin-filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
                <input class="form-control" placeholder="Buscar por vendedor, empresa, email ou CNPJ" @bind="search" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" type="submit">Buscar</button>
            </form>

            <table class="table admin-data-table">
                <thead>
                    <tr>
                        <th></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortSellers("name")'>Vendedor</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortSellers("company")'>Empresa</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortSellers("email")'>Email</button></th>
                        <th><button class="table-sort" type="button" @onclick='() => SortSellers("cnpj")'>CNPJ</button></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var seller in sellers)
                    {
                        <tr>
                            <td class="actions-column">
                                <div class="action-cell">
                                    <button class="btn btn-sm btn-outline-secondary icon-action" type="button" title="Editar" @onclick="() => Edit(seller)">
                                        <i class="fa fa-pen"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger icon-action" type="button" title="Excluir" @onclick="() => DeleteAsync(seller.Id)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                            <td>@seller.Name @seller.LastName</td>
                            <td>@(seller.FantasyName ?? seller.Company)</td>
                            <td>@seller.Email</td>
                            <td>@seller.Cnpj</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private bool loading;
    private string? message;
    private bool successMessage;
    private AdminSeller[] sellers = [];
    private SellerForm form = new();
    private string search = string.Empty;
    private string sort = "name";
    private string direction = "asc";

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAuthenticated)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        sellers = await Api.GetAdminSellersAsync(search, sort, direction);
        loading = false;
    }

    private async Task SearchAsync() => await LoadAsync();

    private async Task SortSellers(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
        }
        else
        {
            sort = column;
            direction = "asc";
        }

        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        if (form.Id is null)
        {
            var result = await Api.CreateSellerAsync(form.ToCreateRequest());
            message = result.Message;
            successMessage = result.Succeeded;
            if (!result.Succeeded)
            {
                return;
            }
        }
        else
        {
            var result = await Api.SaveSellerAsync(form.ToRequest());
            message = result.Message;
            successMessage = result.Succeeded;
            if (!result.Succeeded)
            {
                return;
            }
        }

        ResetForm();
        await LoadAsync();
    }

    private async Task DeleteAsync(Guid id)
    {
        var seller = sellers.FirstOrDefault(item => item.Id == id);
        if (seller is not null)
        {
            var confirmed = await Js.InvokeAsync<bool>("confirm", $"Excluir o vendedor {seller.Name} {seller.LastName}? Esta acao nao pode ser desfeita.");
            if (!confirmed)
            {
                return;
            }
        }

        var result = await Api.DeleteSellerAsync(id);
        message = result.Message;
        successMessage = result.Succeeded;
        if (result.Succeeded)
        {
            ResetForm();
            await LoadAsync();
        }
    }

    private void Edit(AdminSeller seller)
    {
        form = SellerForm.From(seller);
    }

    private void ResetForm()
    {
        form = new SellerForm();
    }

    private sealed class SellerForm
    {
        public Guid? Id { get; set; }
        public string Login { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? Cpf { get; set; }
        public int? Age { get; set; }
        public string? Email { get; set; }
        public string? DateOfBirthText { get; set; }
        public string? Website { get; set; }
        public string? Company { get; set; }
        public string? Cnpj { get; set; }
        public string? BranchOfActivity { get; set; }
        public string? FantasyName { get; set; }

        public static SellerForm From(AdminSeller seller) =>
            new()
            {
                Id = seller.Id,
                Name = seller.Name,
                LastName = seller.LastName,
                Cpf = seller.Cpf,
                Age = seller.Age,
                Email = seller.Email,
                DateOfBirthText = seller.DateOfBirth?.ToString("yyyy-MM-dd"),
                Website = seller.Website,
                Company = seller.Company,
                Cnpj = seller.Cnpj,
                BranchOfActivity = seller.BranchOfActivity,
                FantasyName = seller.FantasyName
            };

        public AdminSellerRequest ToRequest() =>
            new(
                Id!.Value,
                Name.Trim(),
                LastName.Trim(),
                Cpf,
                Age,
                Email,
                DateOnly.TryParse(DateOfBirthText, out var dateOfBirth) ? dateOfBirth : null,
                Website,
                Company,
                Cnpj,
                BranchOfActivity,
                FantasyName);

        public AdminSellerCreateRequest ToCreateRequest() =>
            new(
                Name.Trim(),
                LastName.Trim(),
                Login.Trim(),
                Password,
                Cpf,
                Age,
                Email,
                DateOnly.TryParse(DateOfBirthText, out var dateOfBirth) ? dateOfBirth : null,
                Website,
                Company,
                Cnpj,
                BranchOfActivity,
                FantasyName);
    }
}
