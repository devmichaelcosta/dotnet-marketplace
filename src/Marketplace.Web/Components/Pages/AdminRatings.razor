@page "/admin/ratings"
@attribute [Authorize(Roles = "admin")]
@rendermode InteractiveServer
@inject MarketplaceApiClient Api
@inject ClientState State

<PageTitle>Avaliacoes pendentes</PageTitle>

<div class="toolbar">
    <div>
        <h1>Avaliacoes</h1>
        <p>Aprovacao administrativa das avaliacoes enviadas por usuarios.</p>
    </div>
</div>

@if (!State.IsAuthenticated || !State.IsAdmin)
{
    <p>Faca login como admin para acessar esta area.</p>
}
else if (loading)
{
    <p>Carregando avaliacoes...</p>
}
else if (ratings.Length == 0)
{
    @if (!string.IsNullOrWhiteSpace(successMessage))
    {
        <p class="notice notice-success">@successMessage</p>
    }
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p class="notice">@errorMessage</p>
    }
    <p>Nenhuma avaliacao pendente.</p>
}
else
{
    <div class="table-panel">
        @if (!string.IsNullOrWhiteSpace(successMessage))
        {
            <p class="notice notice-success">@successMessage</p>
        }
        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="notice">@errorMessage</p>
        }

        <form class="admin-filter-bar" @onsubmit="SearchAsync" @onsubmit:preventDefault="true">
            <input class="form-control" placeholder="Buscar por produto, usuario ou titulo" @bind="search" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="submit">Buscar</button>
        </form>

        <table class="table admin-data-table">
            <thead>
                <tr>
                    <th></th>
                    <th><button class="table-sort" type="button" @onclick='() => SortRatings("product")'>Produto</button></th>
                    <th><button class="table-sort" type="button" @onclick='() => SortRatings("user")'>Usuario</button></th>
                    <th><button class="table-sort" type="button" @onclick='() => SortRatings("title")'>Avaliacao</button></th>
                    <th class="number-cell"><button class="table-sort" type="button" @onclick='() => SortRatings("rating")'>Nota</button></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var rating in ratings)
                {
                    <tr>
                        <td class="actions-column">
                            <div class="action-cell">
                                <button class="btn btn-sm btn-primary icon-action" type="button" title="Aprovar" @onclick="() => ApproveAsync(rating.Id)">
                                    <i class="fa fa-check"></i>
                                </button>
                            </div>
                        </td>
                        <td>@rating.ProductTitle</td>
                        <td>@rating.UserName</td>
                        <td>
                            <strong>@rating.Title</strong>
                            <p>@rating.Description</p>
                        </td>
                        <td>@rating.Rating</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private bool loading;
    private PendingRating[] ratings = [];
    private string search = string.Empty;
    private string sort = "rating";
    private string direction = "desc";
    private string? successMessage;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (State.IsAdmin)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        loading = true;
        ratings = await Api.GetPendingRatingsAsync(search, sort, direction);
        loading = false;
    }

    private async Task SearchAsync() => await LoadAsync();

    private async Task SortRatings(string column)
    {
        if (sort == column)
        {
            direction = direction == "asc" ? "desc" : "asc";
        }

        if (sort != column)
        {
            sort = column;
            direction = "asc";
        }

        await LoadAsync();
    }

    private async Task ApproveAsync(int id)
    {
        successMessage = null;
        errorMessage = null;
        var result = await Api.ApproveRatingAsync(id);
        if (result.Succeeded)
        {
            successMessage = result.Message;
        }
        else
        {
            errorMessage = result.Message;
        }

        await LoadAsync();
    }
}
