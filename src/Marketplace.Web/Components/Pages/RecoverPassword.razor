@page "/recover-password"
@rendermode InteractiveServer

<PageTitle>Recuperar senha</PageTitle>

<section class="legacy-auth-shell">
    <div class="auth-shell-split auth-shell-recover">
    <div class="auth-promo-panel auth-promo-panel-soft">
        <span class="market-eyebrow">Recuperacao</span>
        <h1>Recupere o acesso sem perder seu historico de compras</h1>
        <p>Informe seu login para preparar a solicitacao de recuperacao. A entrega do fluxo de envio continua planejada para uma etapa futura.</p>
        <div class="auth-promo-list">
            <div>
                <strong>Sem recomeçar do zero</strong>
                <span>Sua conta, curtidos e pedidos permanecem preservados.</span>
            </div>
            <div>
                <strong>Fluxo simples</strong>
                <span>Uma entrada rapida e um retorno claro sobre a solicitacao.</span>
            </div>
        </div>
    </div>

    <EditForm Model="form" OnSubmit="RequestRecovery" FormName="recover-form" class="legacy-auth-card auth-card-panel">
        <span class="market-eyebrow text-center">Acesso</span>
        <h2 class="auth-card-title">Recupere o acesso a sua conta</h2>
        <p class="auth-card-subtitle">Digite o login cadastrado e siga para a confirmacao da solicitacao.</p>
        <label>
            Login
            <InputText class="form-control" @bind-Value="form.Login" />
        </label>
        <button class="btn btn-primary w-100" type="submit">Continuar</button>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="notice">@message</p>
        }
        <a class="a-primary d-block text-center mt-2" href="login">Voltar ao login</a>
    </EditForm>
    </div>
</section>

@code {
    private RecoverForm form = new();
    private string? message;

    private void RequestRecovery()
    {
        message = string.IsNullOrWhiteSpace(form.Login)
            ? "Informe seu login para iniciar a recuperacao."
            : "Solicitacao registrada. A integracao de envio de recuperacao sera habilitada em uma etapa futura.";
    }

    private sealed class RecoverForm
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Login { get; set; } = string.Empty;
    }
}
