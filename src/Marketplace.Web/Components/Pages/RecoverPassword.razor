@page "/recover-password"
@rendermode InteractiveServer

<PageTitle>Recuperar senha</PageTitle>

<section class="legacy-auth-shell">
    <div class="legacy-auth-card">
        <span class="market-eyebrow text-center">Recuperacao</span>
        <h1 class="h4 mb-3 text-center">Recupere o acesso a sua conta</h1>
        <p class="muted text-center">Informe seu login para preparar a solicitacao de recuperacao. A integracao de envio sera conectada futuramente.</p>
        <label>
            Login
            <InputText class="form-control" @bind-Value="login" />
        </label>
        <button class="btn btn-primary w-100" type="button" @onclick="RequestRecovery">Continuar</button>
        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="notice">@message</p>
        }
        <a class="a-primary d-block text-center mt-2" href="login">Voltar ao login</a>
    </div>
</section>

@code {
    private string login = string.Empty;
    private string? message;

    private void RequestRecovery()
    {
        message = string.IsNullOrWhiteSpace(login)
            ? "Informe seu login para iniciar a recuperacao."
            : "Solicitacao registrada. A integracao de envio de recuperacao sera habilitada em uma etapa futura.";
    }
}
