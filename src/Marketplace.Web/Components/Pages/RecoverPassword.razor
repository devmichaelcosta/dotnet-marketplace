@page "/recover-password"
@rendermode InteractiveServer
@inject MarketplaceApiClient Api

<PageTitle>Recuperar senha</PageTitle>

<section class="legacy-auth-shell">
    <div class="auth-shell-split auth-shell-recover">
        <div class="auth-promo-panel auth-promo-panel-soft">
            <span class="market-eyebrow">Recuperacao</span>
            <h1>Recupere o acesso sem perder seu historico de compras</h1>
            <p>Informe seu login. Se a conta puder receber mensagens, enviaremos um link temporario para o email associado.</p>
            <div class="auth-promo-list">
                <div>
                    <strong>Sem recomeçar do zero</strong>
                    <span>Sua conta, curtidos e pedidos permanecem preservados.</span>
                </div>
                <div>
                    <strong>Link temporario</strong>
                    <span>Por seguranca, o link expira e so pode ser usado uma vez.</span>
                </div>
            </div>
        </div>

        <EditForm Model="form" OnValidSubmit="RequestRecoveryAsync" FormName="recover-form" class="legacy-auth-card auth-card-panel" data-testid="recover-password-form">
            <DataAnnotationsValidator />
            <span class="market-eyebrow text-center">Acesso</span>
            <h2 class="auth-card-title">Recupere o acesso a sua conta</h2>
            <p class="auth-card-subtitle">Digite o login cadastrado. A resposta sera a mesma para proteger a privacidade da conta.</p>
            <label for="recover-login">Login</label>
            <InputText id="recover-login" class="form-control" @bind-Value="form.Login" autocomplete="username" data-testid="recover-password-login" />
            <ValidationMessage For="() => form.Login" />
            <button class="btn btn-primary w-100" type="submit" disabled="@isBusy" data-testid="recover-password-submit">
                @(isBusy ? "Enviando..." : "Enviar instrucoes")
            </button>
            @if (!string.IsNullOrWhiteSpace(message))
            {
                <p class="notice" role="status" aria-live="polite" data-testid="recover-password-message">@message</p>
            }
            <a class="a-primary d-block text-center mt-2" href="login">Voltar ao login</a>
        </EditForm>
    </div>
</section>

@code {
    private RecoverForm form = new();
    private string? message;
    private bool isBusy;

    private async Task RequestRecoveryAsync()
    {
        if (isBusy)
        {
            return;
        }

        isBusy = true;
        message = null;
        try
        {
            var result = await Api.RequestPasswordResetAsync(form.Login);
            message = result.Message;
        }
        catch (HttpRequestException)
        {
            message = "Nao foi possivel enviar a solicitacao agora. Tente novamente mais tarde.";
        }
        finally
        {
            isBusy = false;
        }
    }

    private sealed class RecoverForm
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe seu login.")]
        [System.ComponentModel.DataAnnotations.StringLength(256)]
        public string Login { get; set; } = string.Empty;
    }
}