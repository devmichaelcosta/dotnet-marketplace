<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <script>
        (() => {
            const cookieTheme = document.cookie
                .split("; ")
                .find((cookie) => cookie.startsWith("marketplace-theme="))
                ?.split("=")[1];
            let saved = cookieTheme === "dark" || cookieTheme === "light" ? cookieTheme : null;
            try {
                const storageTheme = localStorage.getItem("marketplace-theme");
                if (storageTheme === "dark" || storageTheme === "light") {
                    saved = storageTheme;
                }
            } catch {
            }
            const theme = saved === "dark" || saved === "light"
                ? saved
                : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
            document.documentElement.dataset.theme = theme;
            document.documentElement.dataset.bsTheme = theme;
            document.documentElement.style.colorScheme = theme;
        })();
    </script>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto&display=swap" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Marketplace.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["theme.js"]"></script>
    <script src="@Assets["lib/bootstrap/dist/js/bootstrap.bundle.min.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
